{
  "name": "themerbot",
  "version": "0.1.0",
  "description": "Create themes for telegram android from a picture.",
  "main": "build/index.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "npm run typecheck && node --test --require ts-node/register/transpile-only --require ./test/setup.ts \"test/**/*.test.ts\"",
    "lint": "eslint src/ test/"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThemerBot/ThemerBot.git"
  },
  "author": "Avrumy <contact@lungers.com>",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/ThemerBot/ThemerBot/issues"
  },
  "homepage": "https://github.com/ThemerBot/ThemerBot#readme",
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@snejugal/color": "^2.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "@youtwitface/ntcjs": "^1.0.1",
    "attheme-js": "^3.0.0",
    "color": "^5.0.3",
    "dotenv": "^18.0.9",
    "envalid": "^9.0.0",
    "get-rgba-palette": "^2.0.1",
    "grammy": "^1.46.0",
    "mysql2": "^3.24.6",
    "new-i18n": "^3.0.0-5",
    "redis": "^6.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/color": "^4.2.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
