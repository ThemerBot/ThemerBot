# Required
BOT_TOKEN=TELEGRAM:BOT-TOKEN
SVG_RENDERER_URL=https://svg-renderer.your-domain.com

# Optional (defaults shown). Uncomment to override.
#IMAGES_PATH=/tmp/ThemerBot
#API_ROOT=https://api.telegram.org
# Set to true when API_ROOT points to a local Bot API server sharing its files
#LOCAL_API_ROOT=false

# For docker-compose, set REDIS_HOST=redis and MYSQL_HOST=mysql
#REDIS_HOST=127.0.0.1
#REDIS_PORT=6379

#ENABLE_STATS=false
#MYSQL_HOST=127.0.0.1
#MYSQL_PORT=3306
#MYSQL_USER=themerbot
#MYSQL_PASS=themerbot
#MYSQL_DB=themerbot

# Enables donations when set
#STRIPE_TOKEN=

#SPONSORED_BY=
#SPONSOR_MESSAGE=
